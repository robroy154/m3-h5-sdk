{
  "compilerOptions": {
    "target": "es5",
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "downlevelIteration": true,
    "rootDir": "src",
    "outDir": "build",
    "sourceMap": true,
    "strict": false,
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build", "tests"]
}
